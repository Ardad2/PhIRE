# Dockerfile.topo.multiarch
# TRUE MULTI-ARCHITECTURE SUPPORT
# Works natively on: AMD64 (x86_64), ARM64 (Apple Silicon, NVIDIA Grace)
#
# Build command (builds for multiple platforms at once):
#   docker buildx build --platform linux/amd64,linux/arm64 \
#     -f Dockerfile.topo.multiarch -t yourname/phire-topo:latest --push .
#
# Or build and load locally (single platform):
#   docker buildx build --platform linux/arm64 \
#     -f Dockerfile.topo.multiarch -t phire-topo:latest --load .

FROM python:3.10.13-slim-bullseye

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

# Micromamba configuration
ENV MAMBA_ROOT_PREFIX=/opt/conda
ENV PATH=${MAMBA_ROOT_PREFIX}/bin:${PATH}

# BuildKit automatically provides TARGETARCH (amd64 or arm64)
ARG TARGETARCH

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    bzip2 \
    git \
    build-essential \
    bash \
  && rm -rf /var/lib/apt/lists/*

# Install micromamba (architecture-aware)
RUN set -eux; \
    case "${TARGETARCH}" in \
      amd64)  MAMBA_ARCH="linux-64" ;; \
      arm64)  MAMBA_ARCH="linux-aarch64" ;; \
      *) echo "Unsupported architecture: ${TARGETARCH}" && exit 1 ;; \
    esac; \
    echo "Installing micromamba for ${MAMBA_ARCH}"; \
    curl -Ls "https://micro.mamba.pm/api/micromamba/${MAMBA_ARCH}/latest" \
      | tar -xj -C /usr/local/bin --strip-components=1 bin/micromamba; \
    chmod +x /usr/local/bin/micromamba

# Create environment with LATEST package versions (best multi-arch compatibility)
# NOTE: Version constraints removed to ensure ARM64 availability
# This ensures the image builds successfully on all platforms
RUN echo "Building for ${TARGETARCH} - using latest package versions from conda-forge" && \
    micromamba create -y -n topo -c conda-forge \
    python=3.10 \
    numpy \
    scipy \
    pandas \
    matplotlib \
    scikit-image \
    pot \
    gudhi \
  && micromamba clean -a -y

# Activate the environment
ENV CONDA_DEFAULT_ENV=topo
ENV PATH=${MAMBA_ROOT_PREFIX}/envs/topo/bin:${PATH}

# Build-time sanity check
RUN python -c "import sys; import numpy, scipy, pandas, matplotlib, skimage, gudhi, ot; \
    print(f'✓ Multi-arch build successful for {sys.platform}'); \
    print(f'  Python: {sys.version.split()[0]}'); \
    print(f'  NumPy: {numpy.__version__}'); \
    print(f'  SciPy: {scipy.__version__}'); \
    print(f'  GUDHI: {gudhi.__version__}'); \
    print(f'  POT: {ot.__version__}')"

WORKDIR /work

# Show package versions when container starts
CMD ["python", "-c", "\
import sys, platform; \
import numpy, scipy, pandas, matplotlib, gudhi, ot; \
print(f'Architecture: {platform.machine()}'); \
print(f'Python: {sys.version.split()[0]}'); \
print(f'NumPy: {numpy.__version__}'); \
print(f'SciPy: {scipy.__version__}'); \
print(f'Pandas: {pandas.__version__}'); \
print(f'Matplotlib: {matplotlib.__version__}'); \
print(f'GUDHI: {gudhi.__version__}'); \
print(f'POT: {ot.__version__}');\
"]
