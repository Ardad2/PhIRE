FROM ubuntu:24.04
ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates curl git build-essential cmake ninja-build \
    python3 python3-dev python3-venv python3-pip \
    libboost-system-dev libopengl-dev libxcursor-dev libx11-dev libxt-dev \
    libglu1-mesa-dev libgl1-mesa-dev mesa-common-dev \
    libvtk9-dev python3-vtk9 \
  && rm -rf /var/lib/apt/lists/*

# Create venv with system packages
ENV VIRTUAL_ENV=/opt/venv
RUN python3 -m venv --system-site-packages $VIRTUAL_ENV
ENV PATH="$VIRTUAL_ENV/bin:$PATH"

# Install Python packages
RUN pip install --no-cache-dir --upgrade pip setuptools wheel \
 && pip install --no-cache-dir numpy pandas matplotlib seaborn

# Clone TTK
WORKDIR /opt
RUN git clone --depth 1 https://github.com/topology-tool-kit/ttk.git

# Build TTK with Python bindings enabled
WORKDIR /opt/ttk
RUN mkdir -p build && cd build && cmake .. -G Ninja \
    -DCMAKE_BUILD_TYPE=Release \
    -DTTK_BUILD_STANDALONE_APPS=ON \
    -DTTK_BUILD_PARAVIEW_PLUGINS=OFF \
    -DTTK_BUILD_VTK_WRAPPERS=ON \
    -DTTK_BUILD_VTK_PYTHON_MODULE=ON \
    -DPYTHON_EXECUTABLE=/opt/venv/bin/python \
 && ninja && ninja install

# Fix: Add both possible paths where TTK installs Python modules
ENV PYTHONPATH=/usr/local/lib/python3/dist-packages:/usr/local/lib/python3.12/site-packages

WORKDIR /work
